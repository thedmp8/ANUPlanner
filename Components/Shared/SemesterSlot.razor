@using ANUPlanner.Models
@using ANUPlanner.Services
@inject PlanStateService PlanState
@inject CourseDataService CourseData

<div class="semester-slot @(_isDragOver ? "drag-over" : "")"
     @ondragover:preventDefault="true"
     @ondragover="OnDragOver"
     @ondragleave="OnDragLeave"
     @ondrop="OnDrop">
    <div class="slot-header">
        <span class="slot-label">@OfferingParserService.DisplayLabel(Semester)</span>
        <span class="slot-units">@SlotUnits u</span>
    </div>
    <div class="slot-courses">
        @foreach (var pc in Courses)
        {
            var offering = CourseData.GetOffering(pc.CourseCode, CalendarYear);
            var isElective = pc.CourseCode.StartsWith("ELECTIVE", StringComparison.OrdinalIgnoreCase);

            // Separate error vs non-error issues so styling is accurate
            var courseIssues = IssuesByCourse.TryGetValue(pc.CourseCode, out var issueList) ? issueList : null;
            var hasError   = courseIssues?.Any(i => i.Severity == IssueSeverity.Error) ?? false;
            var hasWarning = courseIssues?.Any(i => i.Severity == IssueSeverity.Warning || i.Severity == IssueSeverity.ManualReview) ?? false;
            // Fallback-year is a warning, not an error — ensure the card is never red solely due to fallback
            var cardClass = isElective ? "elective-course"
                          : pc.IsUnavailable ? "unavailable"
                          : hasError ? "has-issue"
                          : pc.IsFallbackYear ? "fallback"
                          : hasWarning ? "has-warning"
                          : "";

            <div class="planned-course @cardClass"
                 draggable="true"
                 @ondragstart="@(() => OnDragStartPlanned(pc))"
                 title="@BuildTitle(pc, offering, isElective)">
                <div class="pc-row">
                    <span class="pc-code">@(isElective ? "Elective" : pc.CourseCode)</span>
                    <span class="pc-units">@(isElective ? 6 : offering?.Units ?? 6)u</span>
                    <button class="btn-remove" @onclick="@(() => RemoveCourse(pc.Id))" title="Remove">✕</button>
                </div>
                @if (isElective)
                {
                    <div class="pc-title">6-unit Elective</div>
                }
                else if (offering != null)
                {
                    <div class="pc-title">@offering.Title</div>
                }
                @if (pc.IsUnavailable && !isElective)
                {
                    <div class="pc-badge badge-unavailable">No data</div>
                }
                @if (pc.IsFallbackYear && !isElective)
                {
                    <div class="pc-badge badge-fallback">@offering?.Year data</div>
                }
                @if (hasError)
                {
                    <div class="pc-issue-dot dot-error"
                         title="@string.Join("\n", courseIssues!.Where(i => i.Severity == IssueSeverity.Error).Select(i => i.Message))">!</div>
                }
                else if (hasWarning || pc.IsFallbackYear)
                {
                    <div class="pc-issue-dot dot-warning"
                         title="@string.Join("\n", (courseIssues ?? new()).Where(i => i.Severity != IssueSeverity.Error).Select(i => i.Message))">⚠</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int PlanYear { get; set; }
    [Parameter] public int CalendarYear { get; set; }
    [Parameter] public string Semester { get; set; } = "";
    [Parameter] public List<PlannedCourse> Courses { get; set; } = new();
    [Parameter] public Dictionary<string, List<ValidationIssue>> IssuesByCourse { get; set; } = new();
    [Parameter] public EventCallback<string> OnDragStartedCode { get; set; }
    [Parameter] public EventCallback<(int, string)> OnDropped { get; set; }

    private bool _isDragOver;

    private int SlotUnits => Courses.Sum(c =>
        c.CourseCode.StartsWith("ELECTIVE", StringComparison.OrdinalIgnoreCase) ? 6
        : c.IsUnavailable ? 0
        : c.Offering?.Units ?? 6);

    private void OnDragOver() => _isDragOver = true;
    private void OnDragLeave() => _isDragOver = false;

    private async Task OnDrop()
    {
        _isDragOver = false;
        await OnDropped.InvokeAsync((PlanYear, Semester));
    }

    private void RemoveCourse(Guid id) => PlanState.RemoveCourse(id);

    private async Task OnDragStartPlanned(PlannedCourse pc) =>
        await OnDragStartedCode.InvokeAsync($"__MOVE__{pc.Id}");

    private static string BuildTitle(PlannedCourse pc, CourseOffering? offering, bool isElective)
    {
        if (isElective) return "6-unit Elective placeholder";
        if (pc.IsUnavailable) return $"{pc.CourseCode}: No course data found";
        return offering?.Title ?? pc.CourseCode;
    }
}

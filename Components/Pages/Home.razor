@page "/"

<PageTitle>ANU Degree Planner</PageTitle>

<div class="home-hero">
    <h1>ANU Degree Planner</h1>
    <p class="lead">
        Plan your ANU degree accurately using year-specific course data from 2014–2027.
        Validates prerequisites, incompatibilities, semester availability, and degree requirements.
    </p>
    <a class="btn btn-primary btn-lg" href="/planner">Start Planning →</a>

    <div class="feature-grid">
        <div class="feature-card">
            <div class="feature-icon">📅</div>
            <h3>Temporal Accuracy</h3>
            <p>Course data selected by the exact calendar year you plan to take the course.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">✅</div>
            <h3>Prerequisite Validation</h3>
            <p>Automatically checks prerequisites are satisfied before each semester.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">⚠️</div>
            <h3>Incompatibility Checks</h3>
            <p>Detects conflicting courses anywhere in your degree plan.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🎓</div>
            <h3>Degree Requirements</h3>
            <p>Tracks core courses and total units for BCOMP, AACOM, AACRD, AENGI, AENSE, AENRD.</p>
        </div>
    </div>
</div>
